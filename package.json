{
  "name": "css-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:generate": "pnpm prisma generate",
    "prisma:migrate": "pnpm prisma migrate deploy",
    "prisma:seed": "pnpm prisma db seed",
    "start:docker": "pnpm run prisma:generate && pnpm run prisma:migrate && pnpm run prisma:seed && pnpm next build && pnpm next start",
    "preinstall": "npx only-allow pnpm",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ."
  },
  "prisma": {
    "seed": "./node_modules/.bin/ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "braces": "3.0.3",
      "cross-spawn": "7.0.5",
      "diff": "4.0.4",
      "glob": "10.5.0",
      "mdast-util-to-hast": "13.2.1",
      "minimatch": "9.0.7",
      "nanoid": "3.3.8"
    }
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@hookform/resolvers": "^3.10.0",
    "@icons-pack/react-simple-icons": "13.13.0",
    "@internationalized/date": "^3.12.0",
    "@prisma/client": "6.19.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lossless-json": "^4.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "next-auth": "5.0.0-beta.30",
    "next-cloudinary": "6.17.5",
    "next-themes": "0.4.6",
    "nextjs-toploader": "3.9.17",
    "postcss": "8.5.8",
    "prisma": "6.19.2",
    "react": "19.2.4",
    "react-aria": "^3.47.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^9.1.0",
    "react-remove-scroll-bar": "^2.3.8",
    "react-stately": "^3.45.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
